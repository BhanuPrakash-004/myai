{
  "name": "myai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "test:browser": "playwright test",
    "test:release": "node scripts/release-check.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "tsx --test tests/integration/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:status": "tsx scripts/db/status.ts",
    "db:inventory": "tsx scripts/db/legacy.ts inventory",
    "db:import": "tsx scripts/db/legacy.ts import",
    "owner:create": "tsx scripts/owner.ts create",
    "owner:recover": "tsx scripts/owner.ts recover",
    "attachments:reconcile": "tsx scripts/attachments.ts",
    "recovery": "tsx scripts/recovery.ts",
    "recovery:validate": "tsx scripts/recovery-validate.ts",
    "notes:purge": "tsx scripts/purge.ts",
    "test:http": "tsx --test tests/http/*.test.ts",
    "eval": "tsx --test tests/integration/retrieval-graph.test.ts",
    "eval:retrieval": "tsx --test tests/integration/retrieval-graph.test.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:status": "tsx scripts/indexing.ts status",
    "index:retry": "tsx scripts/indexing.ts retry",
    "index:rebuild": "tsx scripts/indexing.ts rebuild",
    "ai:smoke": "tsx scripts/ai-smoke.ts"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "better-auth": "1.7.5",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "eventsource-parser": "3.0.6",
    "graphile-worker": "0.17.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "4.23.13",
    "zod": "4.6.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
