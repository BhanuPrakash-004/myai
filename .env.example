# Copy to .env for Docker/CLI, or .env.local for local Next development.
# Never commit real credentials. Manual capture/search need no AI key.
APP_URL=http://localhost:3000
APP_PORT=3000
# HTTPS deployment only: DNS hostname, with matching APP_URL=https://brain.example.com
APP_DOMAIN=brain.example.com
# Change for each release; retain old image tags for recovery.
MYAI_IMAGE_TAG=local
# Generate independent random values, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BETTER_AUTH_SECRET=
POSTGRES_USER=myai
POSTGRES_PASSWORD=replace-with-a-random-hex-password
POSTGRES_DB=myai
POSTGRES_PORT=55432
DATABASE_URL=postgresql://myai:replace-with-a-random-hex-password@127.0.0.1:55432/myai
DATABASE_POOL_SIZE=5
DATA_DIR=data/attachments

# OpenRouter only. Secrets are read from the server environment, never returned to the browser.
OPENROUTER_API_KEY=
# Choose chat + JSON-schema-capable structured models available to your account.
OPENROUTER_CHAT_MODEL=
OPENROUTER_STRUCTURED_MODEL=
# Examples, not guarantees of free access or provider availability.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_RERANK_MODEL=cohere/rerank-v3.5
EMBEDDING_DIMENSIONS=1536
# Local chunking always runs. Enable AI indexing for embeddings and proposed graph relations.
AI_INDEXING_ENABLED=false
RERANK_ENABLED=false
GRAPH_EXPANSION_ENABLED=false
AI_MAX_OUTPUT_TOKENS=4096
AI_DAILY_REQUEST_LIMIT=200
AI_DAILY_TOKEN_BUDGET=200000
WORKER_CONCURRENCY=2

# Synthetic test data only. Tests create/drop their own random databases.
TEST_DATABASE_URL=postgresql://myai_test:test-only-password@127.0.0.1:55433/myai_test
